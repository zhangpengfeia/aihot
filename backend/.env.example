MYSQL_HOST=152.136.228.231
MYSQL_PORT=3306
MYSQL_DATABASE=aihot
MYSQL_USER=aihot
MYSQL_PASSWORD=replace-with-your-password
GITHUB_TOKEN=
# 可选：JSON 数组，修改搜索关键词时保留 archived/fork 过滤由程序追加。
# SEARCH_QUERIES=["topic:video-generation","\"AI video\" in:name,description,readme"]
CANDIDATE_LIMIT=500
TRACKED_LIMIT=200
REQUEST_INTERVAL=2.1
# 有效数据估算容量（十进制 GB）；达到阈值自动淘汰最旧采集数据，清理至 90%。
# 保留个人资料、创作引用、每个项目最新快照、近两期成功榜单及最近 26 小时批次。
DATABASE_MAX_SIZE_GB=5
DATABASE_CLEANUP_TARGET_RATIO=0.9
# 知识来源可扩展内容分类：必须是可公开读取的 RSS 2.0 或 Atom。
# 配置此项会替换默认来源列表；不配置时默认接入科技/商业/历史/自然/生活。
# KNOWLEDGE_SOURCES=[{"name":"我的科技源","url":"https://example.com/feed.xml","category":"科技","topic_kind":"热点候选"}]

# 首次初始化管理员；创建后更改此配置不会重置数据库中的密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
