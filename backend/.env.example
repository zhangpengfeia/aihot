MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=aihot
MYSQL_USER=aihot
MYSQL_PASSWORD=replace-with-your-password
GITHUB_TOKEN=
# 可选：JSON 数组，修改搜索关键词时保留 archived/fork 过滤由程序追加。
# SEARCH_QUERIES=["topic:agent-skills","\"agent skills\" in:name,description,readme"]
CANDIDATE_LIMIT=200
TRACKED_LIMIT=200
REQUEST_INTERVAL=2.1
# 知识来源可扩展内容分类：必须是可公开读取的 RSS 2.0 或 Atom。
# 配置此项会替换默认来源列表；不配置时默认接入科技/商业/历史/自然/生活。
# KNOWLEDGE_SOURCES=[{"name":"我的科技源","url":"https://example.com/feed.xml","category":"科技","topic_kind":"热点候选"}]
