{
  "name": "aihot-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src vite.config.ts index.html",
    "format:check": "prettier --check src vite.config.ts index.html",
    "test:store": "node --test tests/dashboardStore.test.mjs",
    "test:workspace": "node --test tests/workspaceTabs.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "antd": "^6.6.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "vite": "^6.0.0"
  }
}
